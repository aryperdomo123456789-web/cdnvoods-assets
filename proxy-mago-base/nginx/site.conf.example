server {
    listen 80;
    server_name painel.seudominio.com;

    root /opt/proxy-mago/proxy-mago-base/public;
    index index.php;

    access_log /opt/proxy-mago/proxy-mago-base/storage/logs/access.log;
    error_log /opt/proxy-mago/proxy-mago-base/storage/logs/error.log;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location /media/ {
        proxy_pass http://45.140.192.237:80;
        proxy_http_version 1.1;
        proxy_set_header Host 45.140.192.237;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_buffering off;
        proxy_request_buffering off;
    }

    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_pass unix:/run/php/php8.1-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
    }
}
